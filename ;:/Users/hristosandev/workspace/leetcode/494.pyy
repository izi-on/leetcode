from collections import defaultdict


class Solution:
    def findTargetSumWays(self, nums: List[int], target: int) -> int:
        track_count_of_sum = defaultdict(int)
        track_count_of_sum[nums[0]] = 1
        track_count_of_sum[-nums[0]] = 1
        for i in range(len(nums)):
            print("Adding: ", nums[i])
            print(track_count_of_sum)
            temp = track_count_of_sum.copy()
            for sum_t in temp.keys():
                temp[sum_t - nums[i]] += track_count_of_sum[sum_t]
                temp[sum_t + nums[i]] += track_count_of_sum[sum_t]
            track_count_of_sum = temp
        return track_count_of_sum[target]
