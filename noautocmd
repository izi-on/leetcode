from functools import reduce


class Solution:
    def maximumValueSum(self, nums: List[int], k: int, edges: List[List[int]]) -> int:
        to_gain = list(map(lambda x: max(0, (x ^ k) - x), nums))
        num_candidates = reduce(lambda acc, x: acc + 1 if x > 0 else acc, to_gain, 0)
        return (
            sum(to_gain) + sum(nums)
            if num_candidates % 2 == 0
            else sum(filter(lambda x: x != min(to_gain), to_gain)) + sum(nums)
        )
